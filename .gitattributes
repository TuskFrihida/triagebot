# Normalise line endings so the repository is identical regardless of whether
# a contributor is on Windows, macOS or Linux. Without this, a Windows clone
# commits CRLF and every file shows as fully modified on a Linux machine.
* text=auto eol=lf

# Explicit for the file types in this project.
*.py    text eol=lf
*.md    text eol=lf
*.toml  text eol=lf
*.txt   text eol=lf
*.json  text eol=lf
*.yml   text eol=lf

# Never touch these.
*.png   binary
*.jpg   binary
*.ico   binary
