# TriageBot configuration template.
#
#   copy this file to .env and fill in your own values
#
# .env is gitignored and must never be committed. Nothing in THIS file is a
# real credential -- every value below is a placeholder.

# --- OpenAI -----------------------------------------------------------------
# Create a key at https://platform.openai.com/api-keys
# The API is billed separately from any ChatGPT subscription, and new accounts
# do not include free credit.
OPENAI_API_KEY=sk-proj-replace-with-your-own-key

# Cheapest model capable of this task. Overridable so the model can be
# upgraded without a code change.
OPENAI_MODEL=gpt-5-nano

# Leave BLANK for OpenAI.
#
# Setting this points the same code at any OpenAI-compatible provider, which
# is useful for development without an OpenAI balance. Examples:
#   Gemini  https://generativelanguage.googleapis.com/v1beta/openai/
#   Ollama  http://localhost:11434/v1
#
# When set, the classifier uses /v1/chat/completions instead of /v1/responses,
# because /v1/responses is OpenAI-only. Both enforce the same JSON schema.
OPENAI_BASE_URL=

# --- Google Sheets ----------------------------------------------------------
# Path to the service-account JSON key, relative to the project root.
# See the README for how to create one and share the spreadsheet with it.
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/google-service-account.json

# The long id from the spreadsheet URL:
#   https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=replace-with-your-spreadsheet-id

# Tab to write to. Created automatically, with headers, if it does not exist.
GOOGLE_WORKSHEET_NAME=Inquiries

# --- Telegram ---------------------------------------------------------------
# Token from @BotFather.
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-own-bot-token

# Numeric chat id. It is not shown anywhere in the Telegram UI -- message your
# bot, then run: python scripts/get_chat_id.py
TELEGRAM_CHAT_ID=replace-with-your-numeric-chat-id

# --- Operational ------------------------------------------------------------
# DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO
